- if the deliver was offline i need to take the order on him and return them from assigned to ready for ex:
        export async function releaseAssignedOrderToReady(
            agentId: number,
            conn: Knex,
        ): Promise<number> {
            const updated = await conn("orders")
                .where({delivery_agent_id: agentId, status: "assigned"})
                .update({
                    status: "ready",
                    delivery_agent_id: null,
                    assigned_at: null,
                    updated_at: conn.fn.now(),
                });
            return updated;
        }


